# ==============================================================================
# FLIC AI OPS DASHBOARD - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This is a unified .env template. It covers both Frontend (VITE_*) and Backend
# configurations. Copy this file to `.env` in the root directory and fill in 
# the actual values. DO NOT commit the `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Vite exposes variables prefixed with VITE_ to the browser.
VITE_API_BASE_URL=http://127.0.0.1:5000
VITE_API_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 2. BACKEND & API CONFIGURATION
# ------------------------------------------------------------------------------
# Cổng chạy backend server
PORT=5000

APP_ENV=development
APP_NAME="FLIC FastAPI Backend"
APP_VERSION="fastapi-v1"
APP_AUTH_SECRET=your-secret-key-minimum-32-chars
APP_AUTH_TTL_SECONDS=3600

# Cấu hình CORS
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Thông tin kết nối Microsoft SQL Server
DB_SERVER=your_db_host
DB_PORT=1433
DB_NAME=Dashboard_ChatBot
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_DRIVER="ODBC Driver 17 for SQL Server"
DB_TIMEOUT_SECONDS=5

# Mã hóa kết nối (đặt false nếu database không cấu hình SSL/TLS)
DB_ENCRYPT=false

# Cho phép tự ký chứng chỉ SSL/TLS
DB_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------------------------------------------
# 4. AI API KEYS (LLMs)
# ------------------------------------------------------------------------------
# Khóa API để gọi AI (Gemini hoặc OpenAI). Hỗ trợ nhiều key cách nhau bằng dấu phẩy
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
OPENAI_API_KEY=your_openai_api_key_1,your_openai_api_key_2

# ------------------------------------------------------------------------------
# 5. HUGGING FACE INFERENCE & BACKGROUND WORKER
# ------------------------------------------------------------------------------
HF_TOKEN=your_huggingface_token
HUGGINGFACE_API_KEY=
HF_MODEL=wonrax/phobert-base-vietnamese-sentiment
HF_PROVIDER=hf-inference
HF_TIMEOUT_SECONDS=15
HF_MAX_RETRIES=2
HF_MAX_CONCURRENCY=3
HF_BATCH_SIZE=10

# Bật/Tắt background worker phân tích cảm xúc
HF_BACKGROUND_ENABLED=true
HF_BACKGROUND_INTERVAL_SECONDS=300

# ID tin nhắn bắt đầu quét (Cutover ID) - Khởi tạo từ lúc Pilot
HF_ANALYSIS_CUTOVER_MESSAGE_ID=56363

# Môi trường an toàn cho Pilot DB
HF_PILOT_ENVIRONMENT=development
HF_PILOT_BACKUP_VERIFIED=true

HF_PROCESSING_STALE_MINUTES=10
HF_PREDICT_RATE_LIMIT_PER_MINUTE=30

# ------------------------------------------------------------------------------
# 6. SMTP CONFIGURATION (OTP & Notifications)
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_SENDER=your_email@gmail.com

# ------------------------------------------------------------------------------
# 7. CELERY & REDIS CONFIGURATION (Legacy/Optional)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_ENQUEUE_ON_STARTUP=true
