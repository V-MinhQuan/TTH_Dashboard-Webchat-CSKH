# Đường dẫn kết nối API Backend (dành cho Frontend React/Vite)
VITE_API_BASE_URL=http://14.225.192.252:8000
VITE_API_TIMEOUT_MS=15000

# Cổng chạy backend server
PORT=5000

# Thông tin kết nối Microsoft SQL Server
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SERVER=your_db_server
DB_PORT=1433
DB_DATABASE=your_db_name

# Mã hóa kết nối (đặt false nếu database không cấu hình SSL/TLS)
DB_ENCRYPT=false

# Cho phép tự ký chứng chỉ SSL/TLS
DB_TRUST_SERVER_CERTIFICATE=true

# Origin công khai của frontend hosting (FastAPI đọc biến CORS_ORIGINS).
CORS_ORIGINS=http://14.225.192.252:8081
