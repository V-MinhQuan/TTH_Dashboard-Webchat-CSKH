# Node.js rollback backend
PORT=5000

# FastAPI migration backend
APP_ENV=development
APP_NAME=FLIC FastAPI Backend
APP_VERSION=fastapi-v1
FASTAPI_PORT=5000

# Microsoft SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=dbFLIC_dev
DB_NAME=dbFLIC_dev
DB_USER=sa
DB_PASSWORD=your_password
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_TIMEOUT_SECONDS=5

# CORS
CORS_ORIGIN=*
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Hugging Face Inference Providers
# Prefer HF_TOKEN. HUGGINGFACE_API_KEY is a compatibility fallback only.
# Never commit a real token or copy it into a VITE_ variable.
HF_TOKEN=
HUGGINGFACE_API_KEY=
HF_MODEL=wonrax/phobert-base-vietnamese-sentiment
HF_PROVIDER=hf-inference
HF_TIMEOUT_SECONDS=15
HF_MAX_RETRIES=2
HF_MAX_CONCURRENCY=3
HF_EVAL_MAX_REQUESTS=300
HF_BATCH_SIZE=10
HF_BACKGROUND_ENABLED=false
HF_PILOT_MAX_RECORDS=3
# Explicit safety gates for the one-shot DB pilot. Leave disabled until a
# development/staging clone and its backup have been independently verified.
HF_PILOT_ENVIRONMENT=
HF_PILOT_BACKUP_VERIFIED=false
HF_ANALYSIS_CUTOVER_MESSAGE_ID=
HF_BACKGROUND_INTERVAL_SECONDS=10
HF_PROCESSING_STALE_MINUTES=10
HF_PREDICT_RATE_LIMIT_PER_MINUTE=30

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER=your_email@gmail.com
